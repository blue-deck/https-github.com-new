# Browser-safe production configuration
NEXT_PUBLIC_SITE_URL=https://www.bluedeck.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets (generate unique random values; never commit real values)
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_RECOVERY_STATE_SECRET=
JOB_APPLICATION_MEDIA_SIGNING_SECRET=
CRON_SECRET=

# Set only when the deployment is actually behind Cloudflare/Sites.
# Leave unset on Vercel; that runtime is detected independently.
BLUDECK_TRUSTED_PROXY=
